# ---------------------------------------------------------------------------
# Clasp environment. Copy to .env and fill in. Nothing here is committed.
# Values marked TODO(human) require account or device setup; see demo/RUNBOOK.md.
# ---------------------------------------------------------------------------

# --- AWS account / region ---------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
STAGE=dev

# --- Models (Bedrock) --------------------------------------------------------
# Multimodal Claude on Bedrock. Enable model access in the Bedrock console first.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Short evidence videos (one per request, up to ~24 MB inline). Amazon Nova reads video; Claude reads photos.
BEDROCK_VIDEO_MODEL_ID=us.amazon.nova-pro-v1:0
# Bedrock Guardrail (sensitive-information masking). Filled by `make deploy`.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
# Bedrock Knowledge Base (S3 Vectors) holding the compensation policy. Filled by `make deploy`;
# `make kb-sync` uploads the documents and runs the ingestion job. Empty = explain_policy searches the
# bundled policy document locally.
KNOWLEDGE_BASE_ID=
KNOWLEDGE_DATA_SOURCE_ID=
POLICY_DOCS_BUCKET=

# --- Events (EventBridge) ----------------------------------------------------
# EVENTS_MODE=console prints lifecycle events in simulate.py; eventbridge publishes to EVENT_BUS_NAME
# (clasp-<stage>, created by the Events stack and filled by `make deploy`).
EVENTS_MODE=console
EVENT_BUS_NAME=
EVENT_BUS_ARN=
DELIVERY_EVENTS_TOPIC_ARN=
EVENTS_LOG_GROUP=

# --- AgentCore ----------------------------------------------------------------
# Filled by `make agent-deploy` (starter toolkit) and `make deploy`.
AGENT_RUNTIME_ARN=
AGENT_EXECUTION_ROLE_ARN=
AGENT_LOG_KMS_KEY_ARN=
GATEWAY_URL=
GATEWAY_ID=
# Gateway inbound auth (Cognito client credentials). Filled by `make deploy`.
GATEWAY_TOKEN_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET_ARN=
GATEWAY_SCOPE=clasp-gateway/invoke
MEMORY_ID=
TOOLS_FUNCTION_ARN=
# AGENT_MODE=local runs the Strands agent in-process (simulate.py). remote = InvokeAgentRuntime.
AGENT_MODE=local
# AGENT_TOOLS=local calls services/tools in-process; gateway discovers them from AgentCore Gateway (MCP).
AGENT_TOOLS=local
# Deployed Lambdas read values other stacks publish under this SSM prefix (api_base_url, agent_runtime_arn).
SSM_PREFIX=

# --- AgentSafe ----------------------------------------------------------------
# Decionis AgentSafe hosted gateway, e.g. https://clasp.decionisedge.com. Every money decision is POSTed to
# {AGENTSAFE_URL}/decide with the tenant key; the gateway records a Decionis dossier and relays the call to the
# tenant's upstream: Clasp's own POST {API_BASE_URL}/decide (token-protected).
# Deployed, the tenant key and upstream token live in Secrets Manager (…_SECRET_ARN, filled by `make deploy`):
# store the real tenant key with `aws secretsmanager put-secret-value`. The tenant's upstream is the origin of
# API_BASE_URL (the gateway relays the same path).
AGENTSAFE_URL=
AGENTSAFE_TENANT_KEY=
AGENTSAFE_UPSTREAM_TOKEN=
AGENTSAFE_GATEWAY_TIMEOUT=15
# enforcement: if the gateway can't answer, the request is denied and nothing moves (fail closed).
# shadow: the gateway only observes; the reference service decides directly when it is unreachable.
AGENTSAFE_GATEWAY_MODE=enforcement
# The header an enforcing gateway's upstreamCredential sets on relayed calls ("Bearer <token>" for authorization).
AGENTSAFE_UPSTREAM_HEADER=authorization
# Origin proof served at /.well-known/agentsafe-upstream: `make upstream-proof TENANT=clasp ORG=<uuid>` (\n between two).
AGENTSAFE_UPSTREAM_PROOF=
# Alternative: invoke the deployed reference service Lambda directly.
AGENTSAFE_FUNCTION_ARN=
POLICY_PATH=services/agentsafe/policy.yaml
# KMS asymmetric key (ECC_NIST_P256, SIGN_VERIFY). Filled by `make deploy`.
KMS_SIGNING_KEY_ID=
# Max authorization lifetime the executor accepts, in seconds. Never above 120.
AUTHZ_MAX_TTL_SECONDS=120

# --- Data ---------------------------------------------------------------------
ORDERS_TABLE=clasp-orders
LEDGER_TABLE=clasp-ledger
DECISIONS_TABLE=clasp-decisions
NONCES_TABLE=clasp-nonces
CHALLENGES_TABLE=clasp-challenges
ITEMS_TABLE=clasp-items
PARTIES_TABLE=clasp-parties
MEDIA_BUCKET=
# local | dynamodb  (local keeps everything in demo/state for offline simulation)
STORE_MODE=local

# --- Workflow -----------------------------------------------------------------
STATE_MACHINE_ARN=
# local | stepfunctions
WORKFLOW_MODE=local
EXECUTOR_FUNCTION_ARN=

# --- Channels: AWS End User Messaging ------------------------------------------
# TODO(human): link the WhatsApp Business Account in the EUM Social console and
# paste the phone number ID (looks like phone-number-id-xxxxxxxx) and WABA ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_API_VERSION=v20.0
# TODO(human): create the RCS agent + an SMS origination number, put both in one
# pool so SMS fallback is automatic. Paste the pool ID (pool-xxxxxxxx) here.
RCS_POOL_ID=
# AWS agent and test registration IDs are recorded during RCS setup.
RCS_AGENT_ID=
RCS_REGISTRATION_ID=
# Filled by make deploy; used for RCS dispatch-photo uploads into S3.
RCS_MEDIA_ROLE_ARN=
# TODO(human): SMS origination identity (phone number ID, pool ID, or sender ID).
SMS_ORIGINATION_IDENTITY=
# Carrier registration for a dedicated SMS number, when required by its country.
SMS_REGISTRATION_ID=
# SNS topics for inbound traffic. Filled by `make deploy`.
INBOUND_WHATSAPP_TOPIC_ARN=
INBOUND_SMS_TOPIC_ARN=
# console | memory | aws
NOTIFY_MODE=console

# --- Email: Amazon SES v2 ---------------------------------------------------------
# TODO(human): verify these identities while the account is in the SES sandbox.
SES_FROM_EMAIL=clasp@example.com
SUPERVISOR_EMAIL=supervisor@example.com

# --- Identity: Cognito -------------------------------------------------------------
# Filled by `make deploy`. If empty, ingress falls back to phone→party matching.
COGNITO_USER_POOL_ID=
# Comma-separated channels whose unknown senders are enrolled as buyers on first contact (judging / demo),
# e.g. whatsapp. Empty = unknown senders get a "not registered" reply. Each enrolment creates a Cognito user
# bound to the sender's phone, so AgentSafe's identity binding applies to them exactly as to seeded buyers.
AUTO_ENROL_CHANNELS=

# --- Payments: mock PSP ---------------------------------------------------------------
# PSP=mock | stripe (stripe only if time remains)
PSP=mock
# Local only. When deployed, the secret lives in Secrets Manager (PSP_WEBHOOK_SECRET_ARN).
PSP_WEBHOOK_SECRET=change-me-local-only
PSP_WEBHOOK_SECRET_ARN=
# Public base URL of the HTTP API (hosted checkout, courier page, webhooks, approval links). Filled by `make deploy`.
API_BASE_URL=http://localhost:8080
# The WhatsApp business number in E.164, for the "Return to WhatsApp" button on hosted pages. Optional.
WHATSAPP_BUSINESS_NUMBER=

# --- Courier (simulated) ----------------------------------------------------------------
# manual: the courier page records pickup with a parcel photo (use for the recorded demo; `make courier ORDER=<code>`)
# auto:   pickup is scanned as soon as funds are held, with the listing photo (judges can finish an order alone)
COURIER_MODE=auto
# Local only. When deployed, the secret lives in Secrets Manager (COURIER_WEBHOOK_SECRET_ARN).
COURIER_WEBHOOK_SECRET=change-me-local-courier

# --- Evidence ---------------------------------------------------------------------------
# bedrock | stub
EVIDENCE_MODE=stub

# --- Demo parties (E.164). SMS has production access; the sender ID is Swedish.
# Buyer and seller must be distinct. For a live deployment, replace the two
# required placeholders; leave optional buyer2/supervisor phones empty if unused.
DEMO_BUYER_PHONE=+15550000001
DEMO_BUYER2_PHONE=
DEMO_SELLER_PHONE=+15550000002
DEMO_SUPERVISOR_PHONE=
DEMO_BUYER_EMAIL=buyer@example.com
DEMO_BUYER2_EMAIL=buyer2@example.com
DEMO_SELLER_EMAIL=seller@example.com
