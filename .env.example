# ---------------------------------------------------------------------------
# Clasp environment. Copy to .env and fill in. Nothing here is committed.
# Values marked TODO(human) can only be produced in the AWS console.
# ---------------------------------------------------------------------------

# --- AWS account / region ---------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
STAGE=dev

# --- Models (Bedrock) --------------------------------------------------------
# Multimodal Claude on Bedrock. Enable model access in the Bedrock console first.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Bedrock Guardrail (sensitive-information masking). Filled by `make deploy`.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# --- AgentCore ----------------------------------------------------------------
# Filled by `make agent-deploy` (starter toolkit) and `make deploy`.
AGENT_RUNTIME_ARN=
AGENT_EXECUTION_ROLE_ARN=
GATEWAY_URL=
GATEWAY_ID=
# Gateway inbound auth (Cognito client credentials). Filled by `make deploy`.
GATEWAY_TOKEN_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET_ARN=
GATEWAY_SCOPE=clasp-gateway/invoke
MEMORY_ID=
TOOLS_FUNCTION_ARN=
# AGENT_MODE=local runs the Strands agent in-process (simulate.py). remote = InvokeAgentRuntime.
AGENT_MODE=local
# AGENT_TOOLS=local calls services/tools in-process; gateway discovers them from AgentCore Gateway (MCP).
AGENT_TOOLS=local
# Deployed Lambdas read values other stacks publish under this SSM prefix (api_base_url, agent_runtime_arn).
SSM_PREFIX=

# --- AgentSafe ----------------------------------------------------------------
# If set, the adapter POSTs to {AGENTSAFE_URL}/decide (Decionis AgentSafe or the
# deployed reference service). If unset, the bundled reference policy service runs
# in-process with the same contract.
AGENTSAFE_URL=
# Alternative: invoke the deployed reference service Lambda directly.
AGENTSAFE_FUNCTION_ARN=
POLICY_PATH=services/agentsafe/policy.yaml
# KMS asymmetric key (ECC_NIST_P256, SIGN_VERIFY). Filled by `make deploy`.
KMS_SIGNING_KEY_ID=
# Max authorization lifetime the executor accepts, in seconds. Never above 120.
AUTHZ_MAX_TTL_SECONDS=120

# --- Data ---------------------------------------------------------------------
ORDERS_TABLE=clasp-orders
LEDGER_TABLE=clasp-ledger
DECISIONS_TABLE=clasp-decisions
NONCES_TABLE=clasp-nonces
CHALLENGES_TABLE=clasp-challenges
ITEMS_TABLE=clasp-items
PARTIES_TABLE=clasp-parties
MEDIA_BUCKET=
# local | dynamodb  (local keeps everything in demo/state for offline simulation)
STORE_MODE=local

# --- Workflow -----------------------------------------------------------------
STATE_MACHINE_ARN=
# local | stepfunctions
WORKFLOW_MODE=local
EXECUTOR_FUNCTION_ARN=

# --- Channels: AWS End User Messaging ------------------------------------------
# TODO(human): link the WhatsApp Business Account in the EUM Social console and
# paste the phone number ID (looks like phone-number-id-xxxxxxxx) and WABA ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_API_VERSION=v20.0
# TODO(human): create the RCS agent + an SMS origination number, put both in one
# pool so SMS fallback is automatic. Paste the pool ID (pool-xxxxxxxx) here.
RCS_POOL_ID=
# TODO(human): SMS origination identity (phone number ID, pool ID, or sender ID).
SMS_ORIGINATION_IDENTITY=
# SNS topics for inbound traffic. Filled by `make deploy`.
INBOUND_WHATSAPP_TOPIC_ARN=
INBOUND_SMS_TOPIC_ARN=
# console | memory | aws
NOTIFY_MODE=console

# --- Email: Amazon SES v2 ---------------------------------------------------------
# TODO(human): verify these identities while the account is in the SES sandbox.
SES_FROM_EMAIL=clasp@example.com
SUPERVISOR_EMAIL=supervisor@example.com

# --- Identity: Cognito -------------------------------------------------------------
# Filled by `make deploy`. If empty, ingress falls back to phone→party matching.
COGNITO_USER_POOL_ID=

# --- Payments: mock PSP ---------------------------------------------------------------
# PSP=mock | stripe (stripe only if time remains)
PSP=mock
# Local only. When deployed, the secret lives in Secrets Manager (PSP_WEBHOOK_SECRET_ARN).
PSP_WEBHOOK_SECRET=change-me-local-only
PSP_WEBHOOK_SECRET_ARN=
# Public base URL of the HTTP API (hosted checkout, webhooks, approval links). Filled by `make deploy`.
API_BASE_URL=http://localhost:8080

# --- Evidence ---------------------------------------------------------------------------
# bedrock | stub
EVIDENCE_MODE=stub

# --- Demo parties (E.164). TODO(human): verify destination numbers in the SMS sandbox.
DEMO_BUYER_PHONE=+15550000001
DEMO_BUYER2_PHONE=+15550000004
DEMO_SELLER_PHONE=+15550000002
DEMO_SUPERVISOR_PHONE=+15550000003
DEMO_BUYER_EMAIL=buyer@example.com
DEMO_BUYER2_EMAIL=buyer2@example.com
DEMO_SELLER_EMAIL=seller@example.com
